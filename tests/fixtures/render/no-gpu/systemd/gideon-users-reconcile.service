[Unit]
Description=Reconcile GIDEON users with LDAP group membership
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/gideon
ExecStart=/usr/bin/python3 -m gideon users reconcile --now
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
