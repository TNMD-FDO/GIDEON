{
    auto_https disable_certs
    metrics
}

https://$hostname {
    tls /etc/gideon/tls/cert.pem /run/secrets/tls_key
    header Strict-Transport-Security "max-age=31536000"
    request_body {
        max_size 2GB
    }
    # No user text in any log: the six parameters that carry a user's text or
    # choice are replaced by "redacted" in the request URI, the Referer, and a
    # redirect's Location — the chat page's q, redirect, load-url, and youtube,
    # and the frontend's shared and v, which its middleware redirects into q,
    # youtube, or load-url. Flags and ids (model, submit, web-search, ...) stay
    # readable on purpose. The list is the pinned frontend's and is re-read at a
    # frontend bump. The filter re-encodes every query string it touches with
    # its keys sorted; hash is not used (at this Caddy it hashes a constant).
    # The frontend's own access line is off by its Compose command.
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace q redacted
                    replace shared redacted
                    replace redirect redacted
                    replace load-url redacted
                    replace youtube redacted
                    replace v redacted
                }
                request>headers>Referer query {
                    replace q redacted
                    replace shared redacted
                    replace redirect redacted
                    replace load-url redacted
                    replace youtube redacted
                    replace v redacted
                }
                resp_headers>Location query {
                    replace q redacted
                    replace shared redacted
                    replace redirect redacted
                    replace load-url redacted
                    replace youtube redacted
                    replace v redacted
                }
            }
        }
    }
    redir /grafana /grafana/
    handle /grafana/* {
        reverse_proxy grafana:3000 {
            flush_interval -1
        }
    }
    handle {
        reverse_proxy open-webui:8080 {
            flush_interval -1
        }
    }
}

http://:2020 {
    metrics
}
