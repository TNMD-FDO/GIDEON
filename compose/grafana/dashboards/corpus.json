          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH newest AS (\n    SELECT DISTINCT ON (r.gen_id) r.gen_id, r.courts, r.gates\n    FROM build_reports r\n    JOIN index_generations g USING (gen_id)\n    WHERE g.state <> 'retired'\n    ORDER BY r.gen_id, r.written_at DESC\n)\nSELECT split_part(r.gen_id, '__', 2) AS lockfile, court.key AS court,\n       (r.gates->'accounted'->court.key->>'staged')::bigint AS staged,\n       (r.gates->'accounted'->court.key->>'recorded')::bigint AS recorded,\n       (r.gates->'accounted'->court.key->>'ready')::bigint AS ready,\n       (r.gates->'accounted'->court.key->>'failed')::bigint AS failed,\n       (r.gates->'accounted'->court.key->>'pass')::boolean AS pass,\n       (court.value->'anchors'->>'anchored')::bigint AS anchored,\n       (court.value->'agreement'->>'agreed')::bigint AS agreed,\n       (court.value->'agreement'->>'gideon_pairs')::bigint AS gideon_pairs,\n       (court.value->'agreement'->>'map_pairs')::bigint AS map_pairs\nFROM newest r\nCROSS JOIN LATERAL jsonb_each(r.courts) AS court\nORDER BY lockfile DESC, court",
          "refId": "A"
        }
      ],
