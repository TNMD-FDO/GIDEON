      "title": "Generations",
      "type": "table"
    },
    {
      "id": 2,
      "description": "This counts documents by processing status and court in the newest report of each generation that is not retired. Failed documents or a ready count that stops growing during a build need investigation. Follow docs/runbooks/observability.md §3.",
      "datasource": {
        "type": "postgres",
        "uid": "gideon-rows"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lockfile"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "court"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "documents"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "gideon-rows"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH newest AS (\n    SELECT DISTINCT ON (r.gen_id) r.gen_id, r.courts\n    FROM build_reports r\n    JOIN index_generations g USING (gen_id)\n    WHERE g.state <> 'retired'\n    ORDER BY r.gen_id, r.written_at DESC\n)\nSELECT split_part(r.gen_id, '__', 2) AS lockfile, court.key AS court,\n       distribution.key AS status, distribution.value::bigint AS documents\nFROM newest r\nCROSS JOIN LATERAL jsonb_each(r.courts) AS court\nCROSS JOIN LATERAL jsonb_each_text(court.value->'by_status') AS distribution\nORDER BY lockfile DESC, court, status",
          "refId": "A"
        }
      ],
      "title": "Documents by status",
      "type": "table"
    },
