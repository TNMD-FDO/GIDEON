      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "gideon-rows"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH newest AS (\n    SELECT DISTINCT ON (r.gen_id) r.gen_id, r.written_at, r.failed_stage, r.failure_reason, r.wall_clock\n    FROM build_reports r\n    JOIN index_generations g USING (gen_id)\n    WHERE g.state <> 'retired'\n    ORDER BY r.gen_id, r.written_at DESC\n)\nSELECT gen_id, written_at AS report_at, failed_stage, failure_reason,\n       (wall_clock->>'run_seconds')::bigint AS run_seconds,\n       (wall_clock->>'lexical_seconds')::bigint AS lexical_seconds,\n       (wall_clock->>'dense_seconds')::bigint AS dense_seconds,\n       (wall_clock->>'lifecycle_seconds')::bigint AS lifecycle_seconds,\n       (wall_clock->>'whole_build')::boolean AS whole_build\nFROM newest\nORDER BY split_part(gen_id, '__', 2) DESC, gen_id",
