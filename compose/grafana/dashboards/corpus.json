      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "gideon-rows"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT gen_id,\n       (counts->>'dense_scope')::bigint AS scope,\n       (counts->>'dense_copied')::bigint + (counts->>'dense_embedded')::bigint AS written,\n       (counts->>'dense_present')::bigint AS present,\n       (counts->>'dense_copied')::bigint AS copied,\n       (counts->>'dense_embedded')::bigint AS embedded,\n       (counts->>'dense_tokens')::bigint AS tokens,\n       (counts->>'dense_requests')::bigint AS requests,\n       (counts->>'dense_seconds')::bigint AS seconds,\n       (counts->>'dense_indexed')::bigint AS indexed,\n       (counts->>'dense_tokens')::numeric / NULLIF((counts->>'dense_seconds')::numeric, 0) AS tokens_per_second\nFROM index_generations\nWHERE state <> 'retired'\nORDER BY created_at DESC, gen_id",
          "refId": "A"
        }
      ],
      "title": "Embedding progress",
      "type": "table"
    },
    {
      "id": 9,
      "description": "This shows requests waiting and running from the embedding server. A queue that keeps growing means work is arriving faster than it is served. This panel is empty on a no-GPU host, where no embedding server runs. Follow docs/runbooks/observability.md §3.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "unit": "short"
